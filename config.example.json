{
  "_comment": "Music Flow 配置模板。复制为 config.json 后按需修改。config.json 已被 .gitignore 排除，不会提交到仓库。",

  "download": {
    "note": "决定哪些歌会被下载",
    "accept_hires": true,
    "accept_lossless": true,
    "accept_lossy": false,
    "max_albums": 240,
    "lossless_target": 30,
    "sort_mode": "bitrate",
    "min_bitrate": 0
  },

  "guard": {
    "note": "决定哪些歌会被拦截，不进同步文件夹",
    "block_sample_rates": [176400],
    "block_channels": [],
    "block_reason_176400": "176.4kHz 在本机手机链路上会输出噪声，实测炸耳",
    "content_mismatch_blocklist": true
  },

  "covers": {
    "note": "补齐封面/歌词。确认过「网上确实没有」的会写进文件标签记下来（30 天内不再重复查），已在库里的不重查，整库扫描约 0.5 秒且不联网",
    "enabled": true,
    "lyrics": true,
    "netease_lyrics": true,
    "max_per_run": 60
  },

  "decode": {
    "note": "解码加密音乐（ncm/qmc/kgm/vpr/kgg）。无损还原不是转码：里面包的是 flac 就出 flac。必须排在打标签和嵌封面之前 —— 加密文件没法写元数据",
    "enabled": true,
    "threads": 0,
    "delete_source": true
  },

  "sync": {
    "note": "同步到手机。device_id / api_key 属于个人信息，请填自己的。",
    "folder_id": "go-music-dl-downloads",
    "phone_device": "",
    "api_key": "",
    "syncthing_gui": "http://127.0.0.1:18384",
    "syncthing_exe": "C:\\Program Files\\Syncthing\\syncthing.exe",
    "syncthing_args": [
      "--config=C:\\ProgramData\\Syncthing\\config",
      "--data=C:\\ProgramData\\Syncthing\\data",
      "--no-browser"
    ],
    "downloads_dir": "D:\\go-music-dl\\downloads"
  },

  "docker": {
    "desktop_exe": "C:\\Program Files\\Docker\\Docker\\Docker Desktop.exe",
    "containers": ["go-music-dl", "music-monitor"]
  },

  "advanced": {
    "note": "依赖的外部脚本（一般不用改）",
    "library_manager": "D:\\music-monitor\\library-manager.ps1",
    "manage_library_py": "/app/manage_library.py",
    "tag_files_py": "D:\\music-monitor\\tag_files.py",
    "check_integrity_py": "D:\\music-monitor\\check_integrity.py",
    "samplerate_guard_py": "D:\\music-monitor\\samplerate_guard_host.py",
    "audit_quality_ps1": "D:\\music-monitor\\audit_quality.ps1",
    "fix_covers_py": "D:\\music-flow\\scripts\\fix_covers.py",
    "music_decode_exe": "D:\\music-decode\\build\\music_decode.exe"
  }
}
